<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<Border Classes="card"
					Width="300"
					Height="140"/>
		</Border>
	</Design.PreviewWith>

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<SolidColorBrush x:Key="CardBackground" Color="{DynamicResource SystemRegionColor}"/>
			<BoxShadows x:Key="CardBoxShadows">1 1 1.5 1.5 DarkGray</BoxShadows>
			<SolidColorBrush x:Key="WarningBackground"
							 Color="#ffeda3"/>
			<SolidColorBrush x:Key="WarningForeground"
							 Color="#181818"/>
			<SolidColorBrush x:Key="AvatarBackground"
							 Color="#33a955a4"/>
			<SolidColorBrush x:Key="AvatarForeground"
							 Color="#a955a4"/>
			<SolidColorBrush x:Key="ChipHoverBackground"
							 Color="#14a955a4"/>
		</ResourceDictionary>
		<ResourceDictionary x:Key="Dark">
			<SolidColorBrush x:Key="CardBackground"
							 Color="#2c2c2c"/>
			<BoxShadows x:Key="CardBoxShadows">0 0 0 0 Transparent</BoxShadows>
			<SolidColorBrush x:Key="WarningBackground"
							 Color="#e2ca52"/>
			<SolidColorBrush x:Key="WarningForeground"
							 Color="#000"/>
			<SolidColorBrush x:Key="AvatarBackground"
							 Color="#33900cb7"/>
			<SolidColorBrush x:Key="AvatarForeground"
							 Color="#d7a3e8"/>
			<SolidColorBrush x:Key="ChipHoverBackground"
							 Color="#22900cb7"/>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
	<SolidColorBrush x:Key="ButtonBackground"
					 Color="Transparent"/>
	<SolidColorBrush x:Key="ButtonBackgroundPointerOver"
					 Color="{DynamicResource SystemBaseHighColor}"
					 Opacity="0.2"/>
	<SolidColorBrush x:Key="SidebarBackground"
					 Color="{DynamicResource SystemChromeLowColor}"/>
	<SolidColorBrush x:Key="PaneBorderBrush"
					 Color="{DynamicResource SystemBaseLowColor}"/>
	<SolidColorBrush x:Key="HintForeground"
					 Color="{DynamicResource SystemBaseMediumColor}"/>
</ResourceDictionary>
