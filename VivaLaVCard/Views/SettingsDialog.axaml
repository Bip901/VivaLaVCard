<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="using:AvaloniaDialogs.Views"
                    xmlns:res="using:VivaLaVCard.Resources"
                    x:Class="VivaLaVCard.Views.SettingsDialog">
    <StackPanel
        Margin="8"
        MinWidth="320"
        Orientation="Vertical"
        Spacing="8">
        <TextBlock Classes="h1" Text="{x:Static res:Strings.settings_title}" />
        <TextBlock Text="{x:Static res:Strings.theme}" />
        <ComboBox
            x:Name="ThemeComboBox"
            HorizontalAlignment="Stretch">
            <ComboBoxItem Content="{x:Static res:Strings.theme_follow_system}" />
            <ComboBoxItem Content="{x:Static res:Strings.theme_light}" />
            <ComboBoxItem Content="{x:Static res:Strings.theme_dark}" />
        </ComboBox>
    </StackPanel>
</dialogs:BaseDialog>
