<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="using:VivaLaVCard.Resources"
        xmlns:views="using:VivaLaVCard.Views"
        xmlns:dialogs="using:AvaloniaDialogs.Views"
        xmlns:converters="using:Avalonia.Data.Converters"
        xmlns:vm="using:VivaLaVCard.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="1080"
        d:DesignHeight="720"
        x:Class="VivaLaVCard.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static res:Strings.app_title}"
        Width="1080"
        Height="720"
        MinWidth="760"
        MinHeight="320"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">
    <dialogs:ReactiveDialogHost CloseOnClickAway="True" IsMultipleDialogsEnabled="True">
        <Grid Background="{DynamicResource SystemRegionBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="340" Width="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition MinWidth="360" Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Contact list  -->
            <DockPanel Background="{DynamicResource SidebarBackground}" Grid.Column="0">
                <Border
                    Padding="8"
                    DockPanel.Dock="Top">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                                <Button
                                    Classes="chip"
                                    Classes.active="{Binding IsContactsView}"
                                    Click="ContactsChip_Click"
                                    Content="{x:Static res:Strings.contacts_title}" />
                                <Button
                                    Classes="chip"
                                    Classes.active="{Binding IsFilesView}"
                                    Click="FilesChip_Click"
                                    Content="{x:Static res:Strings.files_title}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                                <Button
                                    AutomationProperties.Name="{x:Static res:Strings.open_files_tooltip}"
                                    Classes="round"
                                    Click="OpenContactsButton_Click"
                                    ToolTip.Tip="{x:Static res:Strings.open_files_tooltip}">
                                    <PathIcon Data="{StaticResource IconFileOpen}" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Static res:Strings.open_folder_tooltip}"
                                    Classes="round"
                                    Click="OpenFoldersButton_Click"
                                    ToolTip.Tip="{x:Static res:Strings.open_folder_tooltip}">
                                    <PathIcon Data="{StaticResource IconFolderOpen}" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Static res:Strings.remove_all_files_tooltip}"
                                    Classes="round"
                                    Click="RemoveAllFilesButton_Click"
                                    IsVisible="{Binding HasFiles}"
                                    ToolTip.Tip="{x:Static res:Strings.remove_all_files_tooltip}">
                                    <PathIcon Data="{StaticResource IconClose}" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Static res:Strings.settings_tooltip}"
                                    Classes="round"
                                    Click="SettingsButton_Click"
                                    ToolTip.Tip="{x:Static res:Strings.settings_tooltip}">
                                    <PathIcon Data="{StaticResource IconSettings}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBox
                            x:Name="SearchBox"
                            AutomationProperties.Name="{x:Static res:Strings.search_placeholder}"
                            PlaceholderText="{x:Static res:Strings.search_placeholder}"
                            Text="{Binding SearchQuery}" />
                        <TextBlock Classes="hint" Text="{Binding ContactCountLabel}" />
                    </StackPanel>
                </Border>
                <Grid Margin="8,0,8,8">
                    <ListBox
                        x:Name="ContactsList"
                        Background="Transparent"
                        Classes="contacts"
                        IsVisible="{Binding IsContactsView}"
                        ItemsSource="{Binding FilteredContacts}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="ContactsList_SelectionChanged"
                        SelectedItem="{Binding SelectedContact, Mode=OneWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContactViewModel">
                                <Grid ColumnDefinitions="40,*" ColumnSpacing="12">
                                    <Border
                                        Width="40"
                                        Height="40"
                                        Background="{DynamicResource AvatarBackground}"
                                        ClipToBounds="True"
                                        CornerRadius="20">
                                        <Grid>
                                            <Image
                                                Width="40"
                                                Height="40"
                                                Source="{Binding Photo}"
                                                IsVisible="{Binding Photo, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                                                Stretch="UniformToFill"/>
                                            <PathIcon
                                                Width="22"
                                                Height="22"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding Photo, Converter={x:Static converters:ObjectConverters.IsNull}}"
                                                Data="{StaticResource IconPerson}"
                                                Foreground="{DynamicResource AvatarForeground}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ItemsControl
                        Classes="scrollable virtualizing"
                        IsVisible="{Binding IsFilesView}"
                        ItemsSource="{Binding FilteredFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VCardFileViewModel">
                                <Border
                                    Margin="0,2"
                                    Padding="12,10"
                                    Background="{DynamicResource CardBackground}"
                                    CornerRadius="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Classes="h2"
                                                Text="{Binding FileName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Classes="hint"
                                                Text="{Binding FilePath}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding FilePath}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Static res:Strings.remove_file_tooltip}"
                                            Classes="round"
                                            Click="RemoveFileButton_Click"
                                            ToolTip.Tip="{x:Static res:Strings.remove_file_tooltip}">
                                            <PathIcon Data="{StaticResource IconClose}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>

            <!--  Sidebar resizer  -->
            <Border
                Width="1"
                HorizontalAlignment="Center"
                Background="{DynamicResource PaneBorderBrush}"
                Grid.Column="1"
                IsHitTestVisible="False" />
            <GridSplitter
                AutomationProperties.Name="{x:Static res:Strings.resize_sidebar_tooltip}"
                Background="Transparent"
                Classes="sidebar"
                Grid.Column="1"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns" />

            <!--  Contact details  -->
            <views:ContactView Grid.Column="2" DataContext="{Binding SelectedContact, Mode=OneWay}" />
        </Grid>
    </dialogs:ReactiveDialogHost>
</Window>
