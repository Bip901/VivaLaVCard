<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:res="using:VivaLaVCard.Resources"
             xmlns:vm="using:VivaLaVCard.ViewModels"
             x:Class="VivaLaVCard.Views.ContactView"
             x:DataType="vm:MainWindowViewModel">
    <Grid>
        <ContentControl Content="{Binding}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ContactViewModel">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel
                            Margin="32"
                            Spacing="24">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                                <Panel
                                    Width="96"
                                    Height="96"
                                    VerticalAlignment="Center">
                                    <Border
                                        Background="{DynamicResource AvatarBackground}"
                                        ClipToBounds="True"
                                        CornerRadius="48"
                                        IsVisible="{Binding Photo, Converter={x:Static converters:ObjectConverters.IsNull}}">
                                        <PathIcon
                                            Width="48"
                                            Height="48"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource IconPerson}"
                                            Foreground="{DynamicResource AvatarForeground}" />
                                    </Border>
                                    <Border
                                        ClipToBounds="True"
                                        CornerRadius="48"
                                        IsVisible="{Binding Photo, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                                        <Image Source="{Binding Photo}" Stretch="UniformToFill" />
                                    </Border>
                                </Panel>
                                <SelectableTextBlock
                                    Grid.Column="1"
                                    Classes="display"
                                    Text="{Binding DisplayName}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="24" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ContactSectionViewModel">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="h1" Text="{Binding Title}" />
                                            <ItemsControl ItemsSource="{Binding Fields}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.DataTemplates>
                                                    <DataTemplate x:DataType="vm:ContactPhoneFieldViewModel">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                                            <TextBlock
                                                                MinWidth="110"
                                                                MaxWidth="160"
                                                                VerticalAlignment="Center"
                                                                Classes="hint"
                                                                IsVisible="{Binding Label, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                                                                Text="{Binding Label}"
                                                                TextWrapping="Wrap" />
                                                            <SelectableTextBlock
                                                                VerticalAlignment="Center"
                                                                Focusable="False"
                                                                Grid.Column="1"
                                                                Text="{Binding Value}"
                                                                TextWrapping="Wrap" />
                                                            <Button
                                                                Grid.Column="2"
                                                                ToolTip.Tip="{x:Static res:Strings.call_tooltip}"
                                                                VerticalAlignment="Center"
                                                                Classes="round"
                                                                Click="CallButton_Click">
                                                                <PathIcon Data="{StaticResource IconCall}" />
                                                            </Button>
                                                            <Button
                                                                Grid.Column="3"
                                                                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                                                                VerticalAlignment="Center"
                                                                Classes="round"
                                                                Click="CopyButton_Click">
                                                                <PathIcon Data="{StaticResource IconCopy}" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="vm:ContactEmailFieldViewModel">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                                            <TextBlock
                                                                MinWidth="110"
                                                                MaxWidth="160"
                                                                VerticalAlignment="Center"
                                                                Classes="hint"
                                                                IsVisible="{Binding Label, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                                                                Text="{Binding Label}"
                                                                TextWrapping="Wrap" />
                                                            <SelectableTextBlock
                                                                VerticalAlignment="Center"
                                                                Focusable="False"
                                                                Grid.Column="1"
                                                                Text="{Binding Value}"
                                                                TextWrapping="Wrap" />
                                                            <Button
                                                                Grid.Column="2"
                                                                ToolTip.Tip="{x:Static res:Strings.email_tooltip}"
                                                                VerticalAlignment="Center"
                                                                Classes="round"
                                                                Click="MailButton_Click">
                                                                <PathIcon Data="{StaticResource IconMail}" />
                                                            </Button>
                                                            <Button
                                                                Grid.Column="3"
                                                                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                                                                VerticalAlignment="Center"
                                                                Classes="round"
                                                                Click="CopyButton_Click">
                                                                <PathIcon Data="{StaticResource IconCopy}" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="vm:ContactFieldViewModel">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                            <TextBlock
                                                                MinWidth="110"
                                                                MaxWidth="160"
                                                                VerticalAlignment="Center"
                                                                Classes="hint"
                                                                IsVisible="{Binding Label, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                                                                Text="{Binding Label}"
                                                                TextWrapping="Wrap" />
                                                            <SelectableTextBlock
                                                                VerticalAlignment="Center"
                                                                Focusable="False"
                                                                Grid.Column="1"
                                                                Text="{Binding Value}"
                                                                TextWrapping="Wrap" />
                                                            <Button
                                                                Grid.Column="2"
                                                                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                                                                VerticalAlignment="Center"
                                                                Classes="round"
                                                                Click="CopyButton_Click">
                                                                <PathIcon Data="{StaticResource IconCopy}" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.DataTemplates>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!--  Empty state  -->
        <StackPanel
            Margin="32"
            HorizontalAlignment="Center"
            IsVisible="{Binding, Converter={x:Static converters:ObjectConverters.IsNull}}"
            MaxWidth="360"
            Spacing="12"
            VerticalAlignment="Center">
            <Border
                Width="96"
                Height="96"
                HorizontalAlignment="Center"
                Background="{DynamicResource AvatarBackground}"
                ClipToBounds="True"
                CornerRadius="48">
                <PathIcon
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{StaticResource IconPerson}"
                    Foreground="{DynamicResource AvatarForeground}" />
            </Border>
            <TextBlock
                Classes="h1"
                Text="{x:Static res:Strings.no_contact_title}"
                TextAlignment="Center" />
            <TextBlock
                Classes="hint"
                Text="{x:Static res:Strings.no_contact_hint}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
