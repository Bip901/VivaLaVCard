<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:res="using:VivaLaVCard.Resources"
             xmlns:vm="using:VivaLaVCard.ViewModels"
             x:Class="VivaLaVCard.Views.ContactView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/DataTemplates/ContactField.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ContentControl Content="{Binding, Mode=OneWay}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ContactViewModel">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel
                            Margin="32"
                            Spacing="24">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                                <Panel
                                    Width="96"
                                    Height="96"
                                    VerticalAlignment="Center">
                                    <Border
                                        Background="{DynamicResource AvatarBackground}"
                                        ClipToBounds="True"
                                        CornerRadius="48"
                                        IsVisible="{Binding Photo, Converter={x:Static converters:ObjectConverters.IsNull}}">
                                        <PathIcon
                                            Width="48"
                                            Height="48"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource IconPerson}"
                                            Foreground="{DynamicResource AvatarForeground}" />
                                    </Border>
                                    <Border
                                        ClipToBounds="True"
                                        CornerRadius="48"
                                        IsVisible="{Binding Photo, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                                        <Image Source="{Binding Photo}" Stretch="UniformToFill" />
                                    </Border>
                                </Panel>
                                <SelectableTextBlock
                                    Grid.Column="1"
                                    Classes="display"
                                    Text="{Binding DisplayName}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="24" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ContactSectionViewModel">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="h1" Text="{Binding Title}" />
                                            <ItemsControl ItemsSource="{Binding Fields}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.DataTemplates>
                                                    <StaticResourceExtension ResourceKey="ContactAddressField"/>
                                                    <StaticResourceExtension ResourceKey="ContactEmailField"/>
                                                    <StaticResourceExtension ResourceKey="ContactPhoneField"/>
                                                    <StaticResourceExtension ResourceKey="ContactUrlField"/>
                                                    <StaticResourceExtension ResourceKey="ContactTextField"/>
                                                    <StaticResourceExtension ResourceKey="ContactRelationField"/>
                                                </ItemsControl.DataTemplates>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!--  Empty state  -->
        <StackPanel
            Margin="32"
            HorizontalAlignment="Center"
            IsVisible="{Binding, Converter={x:Static converters:ObjectConverters.IsNull}}"
            MaxWidth="360"
            Spacing="12"
            VerticalAlignment="Center">
            <Border
                Width="96"
                Height="96"
                HorizontalAlignment="Center"
                Background="{DynamicResource AvatarBackground}"
                ClipToBounds="True"
                CornerRadius="48">
                <PathIcon
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{StaticResource IconPerson}"
                    Foreground="{DynamicResource AvatarForeground}" />
            </Border>
            <TextBlock
                Classes="h1"
                Text="{x:Static res:Strings.no_contact_title}"
                TextAlignment="Center" />
            <TextBlock
                Classes="hint"
                Text="{x:Static res:Strings.no_contact_hint}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
