<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="using:VivaLaVCard.Resources"
    xmlns:converters="using:Avalonia.Data.Converters"
    xmlns:vm="using:VivaLaVCard.ViewModels">

    <Design.PreviewWith>
        <StackPanel Orientation="Vertical" Margin="8" Width="400">
            <ContentControl ContentTemplate="{DynamicResource ContactAddressField}">
                <vm:ContactAddressFieldViewModel />
            </ContentControl>
            <ContentControl ContentTemplate="{DynamicResource ContactEmailField}">
                <vm:ContactEmailFieldViewModel />
            </ContentControl>
            <ContentControl ContentTemplate="{DynamicResource ContactPhoneField}">
                <vm:ContactPhoneFieldViewModel />
            </ContentControl>
            <ContentControl ContentTemplate="{DynamicResource ContactUrlField}">
                <vm:ContactUrlFieldViewModel />
            </ContentControl>
            <ContentControl ContentTemplate="{DynamicResource ContactTextField}">
                <vm:ContactTextFieldViewModel />
            </ContentControl>
            <ContentControl ContentTemplate="{DynamicResource ContactRelationField}">
                <vm:ContactRelationFieldViewModel />
            </ContentControl>
        </StackPanel>
    </Design.PreviewWith>

    <DataTemplate x:Key="ContactAddressField" x:DataType="vm:ContactAddressFieldViewModel">
        <Grid RowDefinitions="Auto Auto Auto Auto Auto Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock
                MinWidth="110"
                MaxWidth="160"
                VerticalAlignment="Center"
                Classes="hint"
                Text="{Binding Type}"/>
            <Button
                Grid.Column="2"
                ToolTip.Tip="{x:Static res:Strings.open_map_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding MapButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconMap}" />
            </Button>
            <TextBlock
                Margin="16 0 0 0"
                Grid.Row="1"
                VerticalAlignment="Center"
                Classes="hint"
                Text="{x:Static res:Strings.address_street}"
                TextWrapping="Wrap" />
            <SelectableTextBlock
                VerticalAlignment="Center"
                Focusable="False"
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding Street}"
                TextWrapping="Wrap" />
            <Button
                Grid.Row="1"
                Grid.Column="3"
                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding CopyStreetButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconCopy}" />
            </Button>
            <TextBlock
                Margin="16 0 0 0"
                Grid.Row="2"
                VerticalAlignment="Center"
                Classes="hint"
                Text="{x:Static res:Strings.address_locality}"
                TextWrapping="Wrap" />
            <SelectableTextBlock
                VerticalAlignment="Center"
                Focusable="False"
                Grid.Row="2"
                Grid.Column="1"
                Text="{Binding Locality}"
                TextWrapping="Wrap" />
            <Button
                Grid.Row="2"
                Grid.Column="3"
                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding CopyLocalityButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconCopy}" />
            </Button>
            <TextBlock
                Margin="16 0 0 0"
                Grid.Row="3"
                VerticalAlignment="Center"
                Classes="hint"
                Text="{x:Static res:Strings.address_region}"
                TextWrapping="Wrap" />
            <SelectableTextBlock
                VerticalAlignment="Center"
                Focusable="False"
                Grid.Row="3"
                Grid.Column="1"
                Text="{Binding Region}"
                TextWrapping="Wrap" />
            <Button
                Grid.Row="3"
                Grid.Column="3"
                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding CopyRegionButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconCopy}" />
            </Button>
            <TextBlock
                Margin="16 0 0 0"
                Grid.Row="4"
                VerticalAlignment="Center"
                Classes="hint"
                Text="{x:Static res:Strings.address_postal_code}"
                TextWrapping="Wrap" />
            <SelectableTextBlock
                VerticalAlignment="Center"
                Focusable="False"
                Grid.Row="4"
                Grid.Column="1"
                Text="{Binding PostalCode}"
                TextWrapping="Wrap" />
            <Button
                Grid.Row="4"
                Grid.Column="3"
                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding CopyPostalCodeButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconCopy}" />
            </Button>
            <TextBlock
                Margin="16 0 0 0"
                Grid.Row="5"
                VerticalAlignment="Center"
                Classes="hint"
                Text="{x:Static res:Strings.address_country}"
                TextWrapping="Wrap" />
            <SelectableTextBlock
                VerticalAlignment="Center"
                Focusable="False"
                Grid.Row="5"
                Grid.Column="1"
                Text="{Binding Country}"
                TextWrapping="Wrap" />
            <Button
                Grid.Row="5"
                Grid.Column="3"
                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding CopyCountryButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconCopy}" />
            </Button>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ContactEmailField" x:DataType="vm:ContactEmailFieldViewModel">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <TextBlock
                MinWidth="110"
                MaxWidth="160"
                VerticalAlignment="Center"
                Classes="hint"
                Text="{Binding Label}"
                TextWrapping="Wrap" />
            <SelectableTextBlock
                VerticalAlignment="Center"
                Focusable="False"
                Grid.Column="1"
                Text="{Binding Value}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="2"
                ToolTip.Tip="{x:Static res:Strings.email_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding MailButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconMail}" />
            </Button>
            <Button
                Grid.Column="3"
                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding CopyButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconCopy}" />
            </Button>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ContactPhoneField" x:DataType="vm:ContactPhoneFieldViewModel">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <TextBlock
                MinWidth="110"
                MaxWidth="160"
                VerticalAlignment="Center"
                Classes="hint"
                Text="{Binding Label}"
                TextWrapping="Wrap" />
            <SelectableTextBlock
                VerticalAlignment="Center"
                Focusable="False"
                Grid.Column="1"
                Text="{Binding Value}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="2"
                ToolTip.Tip="{x:Static res:Strings.call_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding CallButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconCall}" />
            </Button>
            <Button
                Grid.Column="3"
                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding CopyButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconCopy}" />
            </Button>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ContactUrlField" x:DataType="vm:ContactUrlFieldViewModel">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <TextBlock
                MinWidth="110"
                MaxWidth="160"
                VerticalAlignment="Center"
                Classes="hint"
                Text="{Binding Label}"
                TextWrapping="Wrap" />
            <SelectableTextBlock
                VerticalAlignment="Center"
                Focusable="False"
                Grid.Column="1"
                Text="{Binding Value}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="2"
                ToolTip.Tip="{x:Static res:Strings.open_website_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding OpenWebsiteButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconOpenInBrowser}" />
            </Button>
            <Button
                Grid.Column="3"
                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding CopyButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconCopy}" />
            </Button>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ContactTextField" x:DataType="vm:ContactTextFieldViewModel">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock
                MinWidth="110"
                MaxWidth="160"
                VerticalAlignment="Center"
                Classes="hint"
                Text="{Binding Label}"
                TextWrapping="Wrap" />
            <SelectableTextBlock
                VerticalAlignment="Center"
                Focusable="False"
                Grid.Column="1"
                Text="{Binding Value}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="2"
                ToolTip.Tip="{x:Static res:Strings.copy_tooltip}"
                VerticalAlignment="Center"
                Classes="round"
                Command="{Binding CopyButtonClickCommand}"
                CommandParameter="{Binding $parent[TopLevel]}">
                <PathIcon Data="{StaticResource IconCopy}" />
            </Button>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ContactRelationField" x:DataType="vm:ContactRelationFieldViewModel">
        <StackPanel>
            <TextBlock Classes="h2" Text="{Binding RelationKind}"  Margin="0 8 0 0"/>
            <Grid ColumnDefinitions="40,*" ColumnSpacing="12" Margin="0 8 0 0">
                <Border
                    Width="40"
                    Height="40"
                    Background="{DynamicResource AvatarBackground}"
                    ClipToBounds="True"
                    CornerRadius="20">
                    <Grid>
                        <Image
                            Width="40"
                            Height="40"
                            Source="{Binding Photo}"
                            IsVisible="{Binding Photo, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                            Stretch="UniformToFill"/>
                        <PathIcon
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding Photo, Converter={x:Static converters:ObjectConverters.IsNull}}"
                            Data="{StaticResource IconPerson}"
                            Foreground="{DynamicResource AvatarForeground}" />
                    </Grid>
                </Border>
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding RelativeDisplayName}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
